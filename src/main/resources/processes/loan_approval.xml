<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="Examples">

    <process id="loanApproval" name="Loan Approval" isExecutable="true">
        <startEvent id="start" name="Start"/>
        <sequenceFlow id="flow1" sourceRef="start" targetRef="createTask"/>

        <serviceTask id="createTask"
                     name="Create Task"
                     flowable:class="com.example.CreateTaskDelegate" />
        <sequenceFlow id="flow2" sourceRef="createTask" targetRef="reviewByManager"/>

        <userTask id="reviewByManager"
                  name="Review by Manager (Manager)"
                  flowable:formKey="review-form" >
            <potentialOwner>
                <resourceAssignmentExpression>
                    <formalExpression>manager</formalExpression>
                </resourceAssignmentExpression>
            </potentialOwner>
        </userTask>

        <sequenceFlow id="flow3" sourceRef="reviewByManager" targetRef="riskAssessment"/>

        <userTask id="riskAssessment"
                  name="Risk Assessment (Risk)"
                  flowable:candidateGroups="risk" />

        <sequenceFlow id="flow4" sourceRef="riskAssessment" targetRef="end"/>

        <endEvent id="end"/>
    </process>
</definitions>